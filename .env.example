# DNSGuard — cấu hình qua biến môi trường.
# Chép thành .env và sửa những giá trị cần đổi. Mọi dòng đều có thể bỏ đi:
# giá trị mặc định ghi trong ngoặc.

# ── Đường dẫn và địa chỉ ────────────────────────────────────────────────
# DNSGUARD_DB_PATH=./data/dnsguard.db              (/var/lib/dnsguard/dnsguard.db)
# DNSGUARD_LISTS_DIR=./data/lists                  (/var/lib/dnsguard/lists)
# DNSGUARD_LISTEN=:8080                            (:8080)
# DNSGUARD_TZSP_LISTEN=:37008                      (:37008)

# ── Dữ liệu tùy chọn cho hai tín hiệu ───────────────────────────────────
# Thiếu thì hệ thống vẫn chạy, chỉ mất tín hiệu tương ứng.
# Bảng ASN:    https://iptoasn.com/data/ip2asn-combined.tsv.gz
# DNSGUARD_IP2ASN_PATH=./data/ip2asn.tsv.gz
# Danh sách Tranco — cần cho tín hiệu bảo vệ high_rank, nên tải sớm.
# DNSGUARD_TRANCO_PATH=./data/tranco.csv

# ── Vòng đời domain ─────────────────────────────────────────────────────
# Số ngày một domain nằm ở trạng thái chờ trước khi tự động bị chặn.
# DNSGUARD_STAGING_DAYS=7
# Domain đã chặn chỉ hết hạn sau ngần này ngày không xuất hiện.
# DNSGUARD_CONFIRM_TTL_DAYS=180

# ── Lưu trữ ─────────────────────────────────────────────────────────────
# Query log chứa dữ liệu về hành vi người dùng trong mạng.
# DNSGUARD_LOG_RETENTION_DAYS=90
# DNSGUARD_HOURLY_RETENTION_DAYS=400
# DNSGUARD_KEEP_SNAPSHOTS=30

# ── Xuất bản ────────────────────────────────────────────────────────────
# Chặn xuất bản nếu số lượng sụt dưới tỉ lệ này so với lần trước.
# DNSGUARD_PUBLISH_MIN_RATIO=0.5
# Chỉ các dải IP này tải được /lists/*.txt. Bỏ trống là cho phép tất cả.
# DNSGUARD_LISTS_ALLOW_CIDR=192.168.0.0/16,10.0.0.0/8
# Địa chỉ mọi domain bị chặn trỏ về trong file hosts. 0.0.0.0 làm kết nối hỏng ngay;
# 127.0.0.1 khiến máy khách tự gọi về chính nó và chờ tới khi hết thời gian.
# Đổi được trên giao diện, và giá trị đó thắng biến này.
# DNSGUARD_PUBLISH_SINK=0.0.0.0

# ── Quyền riêng tư ──────────────────────────────────────────────────────
# Đặt false để không gửi truy vấn nào ra Internet ngoài phân giải DNS.
# DNSGUARD_EXTERNAL_ENABLED=true

# Tải trang gốc của domain để phân tích header và HTML tĩnh. Mặc định TẮT: đây là
# nguồn duy nhất gõ cửa trực tiếp máy chủ đích, nên phải chủ động bật.
# DNSGUARD_HTTP_ANALYSIS_ENABLED=false

# Khóa API VirusTotal. Chỉ tra cho domain đã đạt điểm từ 3,0 trở lên, nên bậc miễn
# phí (khoảng 500 lượt/ngày) là đủ với một mạng gia đình.
# Đặt được trên giao diện Cài đặt, và khóa nhập ở đó thắng biến này.
# DNSGUARD_VT_API_KEY=

# ── Theo dõi tài nguyên ─────────────────────────────────────────────────
# Nhịp đo RAM và CPU của chính dịch vụ. Ghi theo lô mỗi phút để đỡ hao thẻ nhớ.
# DNSGUARD_RESOURCE_SAMPLE_SECONDS=10
# Giữ mẫu đo bao lâu. Ba mươi ngày ở nhịp mười giây là khoảng 20 MB.
# DNSGUARD_RESOURCE_RETAIN_DAYS=30

# ── Xác thực ────────────────────────────────────────────────────────────
# Mật khẩu quản trị đầu tiên. Bỏ trống thì hệ thống tự sinh và in ra log
# đúng một lần lúc khởi động.
# DNSGUARD_ADMIN_PASSWORD=
# DNSGUARD_SESSION_TTL_HOURS=168

# ── Vận hành ────────────────────────────────────────────────────────────
# DNSGUARD_LOG_LEVEL=info
# DNSGUARD_AUTO_MIGRATE=true
# Bảo vệ /metrics bằng bearer token. Bỏ trống là không cần token.
# DNSGUARD_METRICS_TOKEN=
